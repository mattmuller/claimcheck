{
  "name": "@mattmuller/claimcheck",
  "version": "0.2.0",
  "description": "Turns a written claim about software into an executable check, then proves the check has teeth by breaking the code it relies on.",
  "type": "module",
  "license": "MIT",
  "author": "Matt Muller <138638+mattmuller@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattmuller/claimcheck.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "claimcheck": "tsx src/cli.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --external:pg --banner:js='#!/usr/bin/env node' --outfile=dist/cli.js && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "homepage": "https://github.com/mattmuller/claimcheck",
  "bugs": "https://github.com/mattmuller/claimcheck/issues",
  "keywords": [
    "claims",
    "verification",
    "mutation-testing",
    "ai-agents",
    "documentation",
    "testing"
  ],
  "bin": {
    "claimcheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
